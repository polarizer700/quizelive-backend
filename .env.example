APP_ENV=local
HTTP_ADDR=:8080
GAME_HTTP_ADDR=:8087
DATABASE_URL=postgres://localhost:5432/quizelive?sslmode=disable

# Локальный seed Ed25519, 32 байта в base64. Только для разработки.
JWT_ED25519_SEED=Jeb0jFvxV6LN0pEN6anTCBMb1Qb9O0XwuUOgnIrDub8=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_HOST_TTL=2m

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5175

# Куда ведёт ссылка из письма.
PUBLIC_APP_URL=http://127.0.0.1:5173
EMAIL_VERIFY_TTL=24h

# Пустой SMTP_HOST — письмо пишется в лог API. Для настоящей почты укажите SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=QuizeLive <noreply@quizelive.local>

# Картинки вопросов. На проде MEDIA_PUBLIC_URL = https://quizlive.ru/media, каталог раздаёт Caddy.
MEDIA_DIR=./.media
MEDIA_PUBLIC_URL=http://127.0.0.1:8086/media
